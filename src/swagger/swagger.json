    "paths": {
        "/cliente/{cnpj}/{banco}": {
            "get": {
                "sumary": "cliente",
                "description": "Cadastro de cliente ",
                "tags": [
                    "Cliente"
                ],
                "responses": {
                    "400": {
                        "description": " Known bug "
                    },
                    "200": {
                        "description": "Retorno do ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/IDResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
